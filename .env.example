# Model path
MODEL_PATH=/path/to/models/Qwen2.5-Coder-7B-Instruct

# Data directory
DATA_DIR=/path/to/data/coalsql

# Database paths - required by the Text2SQL reward
SQL_DATASET_DIR_DEV=/path/to/bird/dev_20240627/dev_databases
SQL_DATASET_DIR_TRAIN=/path/to/bird/train/train_databases
SQL_DATASET_DIR_QB=/path/to/SynSQL-2.5M/databases

# Training result output directory
RESULT_DIR=/path/to/train_results

# WandB
WANDB_API_KEY=your_wandb_api_key_here

# Error-Aware LLM API (required by some scripts)
ERROR_AWARE_LLM_BASE_URL=http://your-llm-api-url/v1
ERROR_AWARE_LLM_API_KEY=your_api_key_here
ERROR_AWARE_LLM_MODEL=model_name
